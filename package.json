{
  "name": "lightpdf",
  "private": true,
  "version": "0.1.0",
  "description": "Free, private PDF tools that run entirely in your browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "package": "npm run build && npm run build:single && node scripts/package.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
